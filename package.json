{
  "name": "procrastin-out",
  "productName": "procrastin-out",
  "version": "1.0.0",
  "description": "Vence la procrastinación — app de escritorio (tareas, hábitos, salud, noticias y logros)",
  "main": "electron/main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "test": "node --test tests/feed-safety.test.js tests/ai-budget.test.js tests/ai-server.test.js tests/ai-broadcast.test.js tests/cache-guard.test.js tests/agent-contract.test.js tests/voice-bridge.test.js tests/meals-photos.test.js",
    "voice": "node scripts/jarvis-voice-bridge.js",
    "cloud": "node server.js",
    "migrate": "node scripts/push-to-cloud.mjs",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "build": {
    "appId": "com.procrastinout.app",
    "productName": "procrastin-out",
    "asar": false,
    "files": [
      "server.js",
      "lib/**/*",
      "public/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "procrastin-out"
    }
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  }
}
